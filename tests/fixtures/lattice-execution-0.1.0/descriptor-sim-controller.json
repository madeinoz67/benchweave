{
  "otdp_version": "0.2.2",
  "descriptor_version": "1.0.0",
  "id": "dev.benchweave.sim-controller",
  "display_name": "BenchWeave simulated DUT controller",
  "description": "Deterministic, entirely synthetic controller DUT: typed uptime telemetry plus an operator note. No profiles, no actions, no hardware, no qualification.",
  "identity": {
    "strategy": "adapter",
    "manufacturer": "benchweave-sim",
    "model": "sim-controller-1",
    "firmware_policy": "listed",
    "supported_firmware": [
      "sim-0.1.0"
    ]
  },
  "integration": {
    "mode": "adapter",
    "adapter": {
      "entry_point": "benchweave_sim_controller.plugin:create_plugin",
      "api_version": "1.1",
      "version": "1.0.0",
      "dependencies": [],
      "permissions": [
        "scoped_transport"
      ]
    }
  },
  "transport": {
    "type": "serial",
    "connection_key": "sim_controller",
    "settings": {
      "baud": 115200,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "rtscts": false,
      "max_frame_bytes": 65536
    }
  },
  "capabilities": [
    "identify",
    "read",
    "write"
  ],
  "operations": {
    "identify": {
      "timeout_ms": 1000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 1000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    },
    "write": {
      "timeout_ms": 1000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    }
  },
  "parameters": [
    {
      "name": "uptime_s",
      "description": "Seconds since the injected boot clock; advances only when the clock advances.",
      "type": "int",
      "access": "ro",
      "semantic": "state",
      "unit": "s",
      "binding": {
        "kind": "adapter",
        "key": "uptime_s"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    },
    {
      "name": "identity_model",
      "description": "Reported device model, for identify/read smoke coverage.",
      "type": "string",
      "access": "ro",
      "semantic": "state",
      "string_constraints": {
        "min_length": 1,
        "max_length": 64
      },
      "binding": {
        "kind": "adapter",
        "key": "identity_model"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    },
    {
      "name": "operator_note",
      "description": "Operator annotation; the device refuses notes longer than 200 characters after dispatch.",
      "type": "string",
      "access": "rw",
      "semantic": "configuration",
      "string_constraints": {
        "min_length": 0,
        "max_length": 200
      },
      "binding": {
        "kind": "adapter",
        "key": "operator_note"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      },
      "write_policy": {
        "effect": "setting",
        "completion": "acknowledged",
        "retry": "never"
      },
      "hazard_class": "none"
    }
  ],
  "required_features": [
    "otdp.core/0.1.0",
    "otdp.adapter/0.1.0"
  ],
  "provenance": {
    "sources": [
      {
        "title": "BenchWeave simulator protocol (synthetic)",
        "reference": "README.md",
        "revision": "1.0.0"
      }
    ],
    "test_vectors": [
      {
        "id": "sim-controller-reads",
        "path": "vectors.json",
        "purpose": "Synthetic controller read/write exchanges; not a device simulator protocol capture"
      }
    ]
  }
}
