{
  "mcpServers": {
    "muninndb-benchweave": {
      "type": "http",
      "url": "http://localhost:8125/mcp",
      "headers": {
        "Authorization": "Bearer ${MUNINN_BENCHWEAVE_KEY}"
      }
    },
    "codanna": {
      "command": "codanna",
      "args": [
        "--config",
        ".codanna/settings.toml",
        "serve",
        "--watch"
      ]
    }
  }
}
