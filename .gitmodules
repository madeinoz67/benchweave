[submodule "packages/sdk"]
	path = packages/sdk
	url = https://github.com/madeinoz67/benchweave-sdk.git
	# The declared pin (gateway #408's checker reads this): the released
	# tag whose bytes this branch's pointer names. A pointer move updates
	# this line in the same commit. v0.16.0 = the interface 0.1.1 sync and
	# the capture_series rider (#450), cut at the registration commit 9e0449e.
	# v0.18.0 = the gateway #463 gap-2 pairing: the classref render arms
	# and the numeric plot-kind expander, cut at 3fa10c7.
	# v0.21.0 = the gateway #541 pairing: the classref 0.4.0 family with
	# composed action classes and the widened claims, cut at 88dcc4d.
	# v0.22.0 = the #556 pairing: the classref 0.5.0 family with
	# composed member declarations, cut at 0d4b44d.
	pin = v0.22.0
