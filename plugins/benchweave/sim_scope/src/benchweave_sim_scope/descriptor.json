{
  "otdp_version": "0.1.1",
  "descriptor_version": "1.0.0",
  "id": "dev.benchweave.sim-scope",
  "display_name": "BenchWeave simulated oscilloscope",
  "description": "Deterministic four-channel simulator; the settings-presets reference instance. No hardware, no qualification.",
  "identity": {
    "strategy": "adapter",
    "manufacturer": "benchweave-sim",
    "model": "sim-scope-1",
    "firmware_policy": "listed",
    "supported_firmware": ["sim-1.0.0"]
  },
  "integration": {
    "mode": "adapter",
    "adapter": {
      "entry_point": "benchweave_sim_scope.plugin:create_plugin",
      "api_version": "1.1",
      "version": "1.0.0",
      "dependencies": [],
      "permissions": ["scoped_transport"]
    }
  },
  "transport": {
    "type": "serial",
    "connection_key": "sim_scope",
    "settings": {
      "baud": 115200,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "rtscts": false,
      "max_frame_bytes": 65536
    }
  },
  "capabilities": ["identify", "read", "write", "invoke"],
  "operations": {
    "identify": {
      "timeout_ms": 1000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 1000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    },
    "write": {
      "timeout_ms": 1000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": true,
      "completion": "readback"
    },
    "invoke": {
      "timeout_ms": 30000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    }
  },
  "parameters": [
    {
      "name": "ch1_probe_ratio",
      "description": "Attenuation ratio for channel 1; the supported values are the discrete set 1x/10x/20x/50x, declared as an enum by the configure action input constraints. The numeric range below spans that set; it does not enumerate it.",
      "type": "float",
      "access": "rw",
      "semantic": "configuration",
      "unit": "1",
      "range": [1.0, 50.0],
      "binding": {"kind": "adapter", "key": "ch1_probe_ratio"},
      "read_policy": {"max_age_ms": 0, "destructive": false},
      "write_policy": {
        "effect": "setting",
        "completion": "readback",
        "retry": "never",
        "verification_parameter": "ch1_probe_ratio",
        "settling_timeout_ms": 1
      },
      "hazard_class": "none"
    },
    {
      "name": "ch1_offset_v",
      "description": "Vertical offset for channel 1.",
      "type": "float",
      "access": "rw",
      "semantic": "configuration",
      "unit": "V",
      "range": [-10.0, 10.0],
      "binding": {"kind": "adapter", "key": "ch1_offset_v"},
      "read_policy": {"max_age_ms": 0, "destructive": false},
      "write_policy": {
        "effect": "setting",
        "completion": "readback",
        "retry": "never",
        "verification_parameter": "ch1_offset_v",
        "settling_timeout_ms": 1
      },
      "hazard_class": "none"
    },
    {
      "name": "ch1_range_v",
      "description": "Full-scale vertical range for channel 1; 1 mV floor.",
      "type": "float",
      "access": "rw",
      "semantic": "configuration",
      "unit": "V",
      "range": [0.001, 10.0],
      "binding": {"kind": "adapter", "key": "ch1_range_v"},
      "read_policy": {"max_age_ms": 0, "destructive": false},
      "write_policy": {
        "effect": "setting",
        "completion": "readback",
        "retry": "never",
        "verification_parameter": "ch1_range_v",
        "settling_timeout_ms": 1
      },
      "hazard_class": "none"
    },
    {
      "name": "ch1_coupling",
      "description": "Input coupling for channel 1.",
      "type": "enum",
      "access": "rw",
      "semantic": "configuration",
      "enum_values": ["ac", "dc", "ground"],
      "binding": {"kind": "adapter", "key": "ch1_coupling"},
      "read_policy": {"max_age_ms": 0, "destructive": false},
      "write_policy": {
        "effect": "setting",
        "completion": "readback",
        "retry": "never",
        "verification_parameter": "ch1_coupling",
        "settling_timeout_ms": 1
      },
      "hazard_class": "none"
    },
