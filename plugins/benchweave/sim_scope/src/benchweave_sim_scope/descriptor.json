  "required_features": [
    "otdp.core/0.1.0",
    "otdp.adapter/0.1.0",
    "otdp.profile_actions/0.1.0",
    "otdp.measurement/0.1.0",
    "otdp.oscilloscope/1.0.0"
  ],
  "provenance": {
    "sources": [
      {
        "title": "BenchWeave simulator protocol (synthetic)",
        "reference": "README.md",
        "revision": "1.0.0"
      }
    ],
    "test_vectors": [
      {
        "id": "sim-scope-actions",
        "path": "vectors.json",
        "purpose": "Synthetic oscilloscope action exchanges; not a device simulator protocol capture"
      }
    ]
  },
  "channels": [
    {
      "id": "ch1",
      "label": "Simulated channel 1",
      "role": "analogue_input",
      "quantities": ["voltage"],
      "parameter_names": ["ch1_probe_ratio", "ch1_offset_v", "ch1_range_v", "ch1_coupling"]
    },
    {
      "id": "ch2",
      "label": "Simulated channel 2",
      "role": "analogue_input",
      "quantities": ["voltage"],
      "parameter_names": ["ch2_probe_ratio", "ch2_offset_v", "ch2_range_v", "ch2_coupling"]
    },
    {
      "id": "ch3",
      "label": "Simulated channel 3",
