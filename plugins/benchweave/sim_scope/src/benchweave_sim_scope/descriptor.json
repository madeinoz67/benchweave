    {
      "name": "identity_model",
      "description": "Reported device model, for identify/read smoke coverage.",
      "type": "string",
      "access": "ro",
      "semantic": "state",
      "string_constraints": {"min_length": 1, "max_length": 64},
      "binding": {"kind": "adapter", "key": "identity_model"},
      "read_policy": {"max_age_ms": 0, "destructive": false}
