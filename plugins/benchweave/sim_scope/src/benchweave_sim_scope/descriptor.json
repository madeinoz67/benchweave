    }
  ],
  "profiles": ["otdp.oscilloscope/1.0.0"],
  "contracts": [
    {
      "id": "urn:otdp:profile-catalog:0.1.1",
      "path": "device-profile-catalog.json",
      "sha256": "fde8e03b21cf5104917e32af8bf5c835a39c62ea97a4c6e61b90b161a5eeced4"
    },
    {
      "id": "urn:otdp:measurement:0.1.1",
