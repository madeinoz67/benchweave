      "sha256": "e2d6bb9d45339ca35f4a3ecec95971356251e0b6cc2b6038759140af00ff621d"
    }
  ],
  "actions": {
    "otdp.oscilloscope.configure/1.0.0": {
      "binding": {"kind": "adapter", "key": "otdp.oscilloscope.configure/1.0.0"},
      "input_constraints": {
        "properties": {
          "channels": {
            "items": {
              "properties": {
                "channel": {"pattern": "^ch[1-4]$"},
                "probe_ratio": {"enum": [1, 10, 20, 50]},
                "range_v": {"minimum": 0.001, "maximum": 10.0},
                "offset_v": {"minimum": -10.0, "maximum": 10.0}
              }
            }
          },
          "sample_rate_hz": {"maximum": 1000000},
          "sample_count": {"maximum": 1000000}
        }
      },
      "timeout_ms": 30000,
      "side_effect": "state_change",
      "cancellable": true,
      "retry": "never"
    },
    "otdp.oscilloscope.arm/1.0.0": {
      "binding": {"kind": "adapter", "key": "otdp.oscilloscope.arm/1.0.0"},
      "input_constraints": {},
