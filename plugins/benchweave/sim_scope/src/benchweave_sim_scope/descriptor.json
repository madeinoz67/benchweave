    {
      "name": "averaging_count",
      "description": "Model averaging depth. Live-write-only: no profile action schema carries an averaging count, so this setting cannot ride preset settings under the closed 0.1.0/0.1.1 action schemas.",
      "type": "int",
      "access": "rw",
      "semantic": "configuration",
      "unit": "1",
      "range": [1, 64],
      "binding": {"kind": "adapter", "key": "averaging_count"},
