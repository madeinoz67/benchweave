# BenchWeave gateway environment — EXAMPLE, placeholders only.
#
# Copy to your EnvironmentFile path (the unit's {{ENV_FILE}}), fill the
# placeholders, and lock the mode down before first start:
#   sudo cp deploy/systemd/benchweave.env.example /etc/benchweave/benchweave.env
#   sudo chown root:benchweave /etc/benchweave/benchweave.env
#   sudo chmod 0600 /etc/benchweave/benchweave.env
#
# This file carries NO real secrets — tests/cli/test_serve.py greps the
# whole deploy/ tree for secret-looking content and fails on hits. Never
# commit the filled copy; the secret is operator-held state (the same
# posture as `benchweave setup`'s benchweave.env).

# Production posture: app_entry refuses to boot on the default test secret
# while this is set (the refusal fires before the store is opened).
BENCHWEAVE_ENV=production

# The state database — inside the unit's ONE writable root ({{DATA_DIR}}).
BENCHWEAVE_DB={{DATA_DIR}}/state.sqlite

# Bind. serve defaults to loopback only; set here so the env file is the
# single place a deployment tunes the bind.
BENCHWEAVE_HOST=127.0.0.1
BENCHWEAVE_PORT=8125

# The gateway secret — generate one, e.g.:  openssl rand -hex 32
# Keep the file mode 0600; the secret is never printed, committed, or
# included in backups.
BENCHWEAVE_SECRET=__GENERATE_AND_STORE_A_REAL_RANDOM_SECRET__
# The browser UI (G2a): on by default; set to 0 to compose the gateway
# without it. The session knobs are the documented defaults.
BENCHWEAVE_UI=1
#BENCHWEAVE_UI_LOGIN_CODE_TTL_MS=60000
#BENCHWEAVE_UI_SESSION_TTL_MS=28800000
#BENCHWEAVE_UI_MAX_BRIDGES_PER_SESSION=4
# The refresh interval of the control panel (G3a). The default is
# 30000 ms. The gateway refuses to boot below 1000 ms.
#BENCHWEAVE_UI_PANEL_POLL_MS=30000
