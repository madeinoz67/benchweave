<div class="bw-rotary">
  <button class="bw-rotary__knob" type="button" role="slider" aria-label="{{ data.label }}"
          aria-valuemin="{{ data.minimum }}" aria-valuemax="{{ data.maximum }}"
          aria-valuenow="{{ data.now }}"
          aria-valuetext="{{ data.now }} {{ data.unit }}, staged"></button>
  <output class="bw-rotary__value">{{ data.now }} {{ data.unit }}</output>
  <span class="bw-rotary__state">Staged</span>
</div>
