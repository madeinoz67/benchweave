<div class="bw-confirm" data-bw-confirm="{{ 'armed' if data.armed else 'idle' }}">
  <button type="button" class="bw-confirm__initial" aria-expanded="{{ 'true' if data.armed else 'false' }}">{{ data.initial_label }}</button>
  <div class="bw-confirm__step">
    <p class="bw-confirm__text">{{ data.armed_text }}</p>
    <button type="button" class="bw-confirm__go">Confirm: {{ data.confirm_label }}</button>
    <button type="button" class="bw-confirm__cancel">Cancel</button>
  </div>
</div>
