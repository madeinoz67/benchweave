<aside class="bw-refusal" role="status" data-bw-refusal-code="{{ data.code }}" data-severity="{{ data.severity }}">
  <div class="bw-refusal__content">
    <strong>{{ data.code }}</strong>
    <p class="bw-refusal__what" data-bw-refusal-what>{{ data.what_happened }}</p>
  </div>
  <p class="bw-refusal__sent" data-bw-sent-status="{{ data.sent_status }}">Sent: {{ data.sent_status }}</p>
  <p class="bw-refusal__action" data-bw-operator-action>{{ data.operator_action }}</p>
</aside>
