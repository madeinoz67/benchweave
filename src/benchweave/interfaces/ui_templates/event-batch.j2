{# One poll batch of bench events — the ONLY payload that rides the
   stream's swap channel. Rendered by the gateway's own environment
   (autoescape on); the gap/advisory slots are the package's §C.3
   partials plus an escaped watermark line, so every byte of the swapped
   fragment is gateway-rendered (the G2a bw-host.js provenance pin). #}
{% if gap_html %}{{ gap_html }}{% endif %}
{% if advisory_html %}{{ advisory_html }}{% endif %}
{% if events %}
<ul class="bw-live-events" data-bw-live-rows">
  {% for event in events %}
  <li data-bw-event-row data-bw-event-kind="{{ event.kind }}" data-bw-event-sequence="{{ event.sequence }}">
    <span class="bw-live-events__seq">{{ event.sequence }}</span>
    <span class="bw-live-events__kind">{{ event.kind }}</span>
    {% if event.get("run_id") %}<a class="bw-link" href="/ui/runs/{{ event.run_id }}">{{ event.run_id }}</a>{% endif %}
    <span class="bw-live-events__at">{{ event.get("at", "") }}</span>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="bw-live-events__empty" data-bw-live-empty>No new events.</p>
{% endif %}
